# Copy to the server project directory as `.env`. Do not commit real values.
BIA_IMAGE=bia:bia-v0.1.0-dev-arm64
BIA_PORT=29090
BIA_DATA_DIR=./data
MAXKB_DEBUG=false
MAXKB_TIME_ZONE=Asia/Shanghai
TZ=Asia/Shanghai

# Opportunity embed access is opt-in. Keep disabled until an integrating
# business system has been approved; existing clients and sessions are kept.
MAXKB_OPPORTUNITY_EMBED_ENABLED=false

# Fresh offline installations populate these values automatically. Existing
# installations keep their current values to avoid invalidating stored data.
MAXKB_SECRET_KEY=
MAXKB_HMAC_SIGNED_SERIALIZER_SECRET_KEY=
POSTGRES_PASSWORD=
MAXKB_DB_PASSWORD=
REDIS_PASSWORD=
MAXKB_REDIS_PASSWORD=

# Fresh installation only. Export MAXKB_DEFAULT_PASSWORD to the installer;
# it is written to this server .env and is not stored in the image or release
# metadata. Leave it empty in source control. Upgrades do not change it.
MAXKB_DEFAULT_PASSWORD=

# Optional trusted portal SSO. Keep every value empty here; set secrets only
# in the target environment's protected .env/secret store.
MAXKB_PORTAL_SSO_ENABLED=
MAXKB_PORTAL_SSO_CLIENT_ID=
MAXKB_PORTAL_SSO_CLIENT_SECRET=
MAXKB_PORTAL_SSO_PREVIOUS_CLIENT_SECRET=
MAXKB_PORTAL_SSO_ALLOWED_CLOCK_SKEW_SECONDS=
MAXKB_PORTAL_SSO_TICKET_TTL_SECONDS=
MAXKB_PORTAL_SSO_AUTO_PROVISION=
MAXKB_PORTAL_SSO_EXISTING_USER_POLICY=
MAXKB_PORTAL_SSO_DEFAULT_WORKSPACE=
MAXKB_PORTAL_SSO_PORTAL_LOGIN_URL=
MAXKB_PORTAL_SSO_ALLOWED_TARGETS=
